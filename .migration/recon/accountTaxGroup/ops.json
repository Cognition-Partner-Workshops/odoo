[
  {
    "name": "tax_groups_per_company",
    "collection": "accountTaxGroup",
    "note": "AccountTaxGroup _check_company_auto and country_id (addons/account/models/account_tax.py): groups per company, how many are country-bound",
    "source_sql": "SELECT company_id, count(*) AS groups, count(country_id) AS with_country FROM account_tax_group GROUP BY company_id ORDER BY company_id",
    "target_pipeline": [
      {
        "$group": {
          "_id": {
            "$ifNull": [
              "$companyId",
              null
            ]
          },
          "groups": {
            "$sum": 1
          },
          "with_country": {
            "$sum": {
              "$cond": [
                {
                  "$ne": [
                    {
                      "$ifNull": [
                        "$countryId",
                        null
                      ]
                    },
                    null
                  ]
                },
                1,
                0
              ]
            }
          }
        }
      },
      {
        "$sort": {
          "_id": 1
        }
      },
      {
        "$project": {
          "_id": 0,
          "company_id": "$_id",
          "groups": 1,
          "with_country": 1
        }
      }
    ],
    "rules": [
      "null_missing_equiv"
    ]
  },
  {
    "name": "tax_groups_in_order",
    "collection": "accountTaxGroup",
    "note": "AccountTaxGroup._order 'sequence asc, id': every group with its company and country in display order",
    "source_sql": "SELECT id, company_id, country_id, sequence FROM account_tax_group ORDER BY sequence, id",
    "target_pipeline": [
      {
        "$sort": {
          "sequence": 1,
          "_id": 1
        }
      },
      {
        "$project": {
          "_id": 0,
          "id": "$_id",
          "company_id": {
            "$ifNull": [
              "$companyId",
              null
            ]
          },
          "country_id": {
            "$ifNull": [
              "$countryId",
              null
            ]
          },
          "sequence": {
            "$ifNull": [
              "$sequence",
              null
            ]
          }
        }
      }
    ],
    "rules": [
      "null_missing_equiv"
    ]
  }
]