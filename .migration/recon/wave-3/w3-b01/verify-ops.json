          "product_id": {
            "$ifNull": [
              "$productId",
              null
            ]
          },
          "package_type_id": {
            "$ifNull": [
              "$packageTypeId",
              null
            ]
          },
          "quantity": 1
        }
      }
    ]
  },
  {
    "name": "orderpoints_per_warehouse_trigger",
    "collection": "stockWarehouseOrderpoint",
    "source_sql": "SELECT warehouse_id, trigger, count(*) AS n, min(product_min_qty) AS min_min_qty, max(product_max_qty) AS max_max_qty, count(DISTINCT product_id) AS n_products, count(DISTINCT location_id) AS n_locations FROM stock_warehouse_orderpoint GROUP BY warehouse_id, trigger",
    "target_pipeline": [
      {
        "$group": {
          "_id": {
            "w": "$warehouseId",
            "t": "$trigger"
          },
          "n": {
            "$sum": 1
          },
          "min_min_qty": {
            "$min": "$productMinQty"
          },
          "max_max_qty": {
            "$max": "$productMaxQty"
          },
          "products": {
            "$addToSet": "$productId"
          },
          "locations": {
            "$addToSet": "$locationId"
          }
        }
      },
      {
        "$project": {
          "_id": 0,
          "warehouse_id": "$_id.w",
          "trigger": "$_id.t",
          "n": 1,
          "min_min_qty": 1,
          "max_max_qty": 1,
          "n_products": {
            "$size": "$products"
          },
          "n_locations": {
            "$size": "$locations"
          }
        }
      }
    ]
  }
]