              "$pickingTypeId",
              null
            ]
          },
          "location_src_id": {
            "$ifNull": [
              "$locationSrcId",
              null
            ]
          },
          "location_dest_id": {
            "$ifNull": [
              "$locationDestId",
              null
            ]
          },
          "warehouse_id": {
            "$ifNull": [
              "$warehouseId",
              null
            ]
          },
          "company_id": {
            "$ifNull": [
              "$companyId",
              null
            ]
          },
          "sequence": {
            "$ifNull": [
              "$sequence",
              null
            ]
          },
          "delay": {
            "$ifNull": [
              "$delay",
              null
            ]
          },
          "active": 1,
          "auto": {
