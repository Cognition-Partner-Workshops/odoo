  {
    "name": "putaway_rules_with_package_type_links",
    "collection": "stockPutawayRule",
    "source_sql": "SELECT p.id, p.product_id, p.category_id, p.location_in_id, p.location_out_id, p.storage_category_id, p.sequence, p.company_id, p.sublocation, p.active, (SELECT count(*) FROM stock_package_type_stock_putaway_rule_rel r WHERE r.stock_putaway_rule_id = p.id) AS n_package_types, (SELECT string_agg(r.stock_package_type_id::text, ',' ORDER BY r.stock_package_type_id) FROM stock_package_type_stock_putaway_rule_rel r WHERE r.stock_putaway_rule_id = p.id) AS package_type_ids FROM stock_putaway_rule p",
    "target_pipeline": [
      {
        "$lookup": {
          "from": "stockPackageType",
          "let": {
            "rid": "$_id"
          },
          "pipeline": [
            {
              "$match": {
                "$expr": {
                  "$in": [
                    "$$rid",
                    {
                      "$ifNull": [
                        {
                          "$map": {
                            "input": "$stockPutawayRuleRel",
                            "in": "$$this.stockPutawayRuleId"
                          }
                        },
                        []
                      ]
                    }
                  ]
                }
              }
            },
            {
              "$sort": {
                "_id": 1
              }
            },
            {
              "$project": {
                "_id": 1
              }
            }
          ],
          "as": "pt"
        }
      },
      {
        "$project": {
          "_id": 0,
          "id": "$_id",
          "product_id": {
            "$ifNull": [
              "$productId",
              null
            ]
          },
          "category_id": {
            "$ifNull": [
              "$categoryId",
              null
            ]
          },
          "location_in_id": "$locationInId",
          "location_out_id": "$locationOutId",
          "storage_category_id": {
            "$ifNull": [
              "$storageCategoryId",
              null
            ]
          },
          "sequence": {
            "$ifNull": [
              "$sequence",
              null
            ]
          },
          "company_id": "$companyId",
          "sublocation": 1,
          "active": 1,
          "n_package_types": {
            "$size": "$pt"
          },
          "package_type_ids": {
            "$cond": [
              {
                "$eq": [
                  {
                    "$size": "$pt"
                  },
                  0
                ]
              },
              null,
              {
                "$reduce": {
                  "input": "$pt",
                  "initialValue": "",
                  "in": {
                    "$concat": [
                      "$$value",
                      {
                        "$cond": [
                          {
                            "$eq": [
                              "$$value",
                              ""
                            ]
                          },
                          "",
                          ","
                        ]
                      },
                      {
                        "$toString": "$$this._id"
                      }
                    ]
                  }
                }
              }
            ]
          }
        }
      }
    ]
  },
  {
