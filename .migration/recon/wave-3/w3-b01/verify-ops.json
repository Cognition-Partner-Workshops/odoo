[
  {
    "name": "warehouses_with_resupply",
    "collection": "stockWarehouse",
    "source_sql": "SELECT w.id, w.code, w.company_id, w.lot_stock_id, w.in_type_id, w.out_type_id, w.reception_steps, w.delivery_steps, w.active, (SELECT count(*) FROM stock_wh_resupply_table r WHERE r.supplied_wh_id = w.id) AS n_resupply, (SELECT min(r.supplier_wh_id) FROM stock_wh_resupply_table r WHERE r.supplied_wh_id = w.id) AS first_supplier FROM stock_warehouse w",
    "target_pipeline": [
      {
        "$project": {
          "_id": 0,
          "id": "$_id",
          "code": 1,
          "company_id": "$companyId",
          "lot_stock_id": "$lotStockId",
          "in_type_id": "$inTypeId",
          "out_type_id": "$outTypeId",
          "reception_steps": "$receptionSteps",
          "delivery_steps": "$deliverySteps",
          "active": 1,
          "n_resupply": {
            "$size": {
              "$ifNull": [
                "$stockWhResupplyTable",
                []
              ]
            }
          },
          "first_supplier": {
            "$ifNull": [
              {
                "$min": "$stockWhResupplyTable.supplierWhId"
              },
              null
            ]
          }
        }
      }
    ]
  },
  {
    "name": "locations_tree_with_wave_picking_types",
    "collection": "stockLocation",
    "source_sql": "SELECT l.id, l.location_id, l.usage, l.complete_name, l.warehouse_id, l.storage_category_id, l.active, l.replenish_location, (SELECT count(*) FROM stock_location_stock_picking_type_rel r WHERE r.stock_location_id = l.id) AS n_picking_types FROM stock_location l",
    "target_pipeline": [
      {
        "$project": {
          "_id": 0,
          "id": "$_id",
          "location_id": {
            "$ifNull": [
              "$locationId",
              null
            ]
          },
          "usage": 1,
          "complete_name": "$completeName",
          "warehouse_id": {
            "$ifNull": [
              "$warehouseId",
              null
            ]
          },
          "storage_category_id": {
            "$ifNull": [
              "$storageCategoryId",
              null
            ]
          },
          "active": 1,
          "replenish_location": {
            "$ifNull": [
              "$replenishLocation",
              null
            ]
          },
          "n_picking_types": {
            "$size": {
              "$ifNull": [
                "$stockPickingTypeRel",
                []
              ]
            }
          }
        }
      }
    ]
  },
  {
    "name": "picking_types_per_warehouse_and_code",
    "collection": "stockPickingType",
    "source_sql": "SELECT warehouse_id, code, count(*) AS n, count(*) FILTER (WHERE active) AS n_active, min(id) AS min_id, max(sequence) AS max_sequence FROM stock_picking_type GROUP BY warehouse_id, code",
    "target_pipeline": [
      {
        "$group": {
          "_id": {
            "w": {
              "$ifNull": [
                "$warehouseId",
                null
              ]
            },
            "c": "$code"
          },
          "n": {
            "$sum": 1
          },
          "n_active": {
            "$sum": {
              "$cond": [
                "$active",
                1,
                0
              ]
            }
          },
          "min_id": {
            "$min": "$_id"
          },
          "max_sequence": {
            "$max": "$sequence"
          }
        }
      },
      {
        "$project": {
          "_id": 0,
          "warehouse_id": "$_id.w",
          "code": "$_id.c",
          "n": 1,
          "n_active": 1,
          "min_id": 1,
          "max_sequence": 1
        }
      }
    ]
  },
  {
    "name": "routes_with_rule_and_link_counts",
    "collection": "stockRoute",
    "source_sql": "SELECT r.id, r.sequence, r.active, r.company_id, r.product_selectable, r.product_categ_selectable, r.warehouse_selectable, r.package_type_selectable, r.sale_selectable, (SELECT count(*) FROM stock_rule s WHERE s.route_id = r.id) AS n_rules, (SELECT count(*) FROM stock_route_categ c WHERE c.route_id = r.id) AS n_categ, (SELECT count(*) FROM stock_route_product p WHERE p.route_id = r.id) AS n_product, (SELECT count(*) FROM stock_route_move m WHERE m.route_id = r.id) AS n_move, (SELECT count(*) FROM stock_route_warehouse w WHERE w.route_id = r.id) AS n_warehouse FROM stock_route r",
    "target_pipeline": [
      {
        "$lookup": {
          "from": "stockRule",
          "localField": "_id",
          "foreignField": "routeId",
          "as": "rules"
        }
      },
      {
        "$project": {
          "_id": 0,
          "id": "$_id",
          "sequence": 1,
          "active": 1,
          "company_id": {
            "$ifNull": [
              "$companyId",
              null
            ]
          },
          "product_selectable": {
            "$ifNull": [
              "$productSelectable",
              null
            ]
          },
          "product_categ_selectable": {
            "$ifNull": [
              "$productCategSelectable",
              null
            ]
          },
          "warehouse_selectable": {
            "$ifNull": [
              "$warehouseSelectable",
              null
            ]
          },
          "package_type_selectable": {
            "$ifNull": [
              "$packageTypeSelectable",
              null
            ]
          },
          "sale_selectable": {
            "$ifNull": [
              "$saleSelectable",
              null
            ]
          },
          "n_rules": {
            "$size": "$rules"
          },
          "n_categ": {
            "$size": {
              "$ifNull": [
                "$categ",
                []
              ]
            }
          },
          "n_product": {
            "$size": {
              "$ifNull": [
                "$product",
                []
              ]
            }
          },
          "n_move": {
            "$size": {
              "$ifNull": [
                "$move",
                []
              ]
            }
          },
          "n_warehouse": {
            "$size": {
              "$ifNull": [
                "$warehouse",
                []
              ]
            }
          }
        }
      }
    ]
  },
