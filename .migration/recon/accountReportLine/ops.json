[
  {
    "name": "lines_in_report_order",
    "collection": "accountReportLine",
    "note": "account.report.line_ids one2many in AccountReportLine._order = 'sequence, id' (addons/account/models/account_report.py): every line with its report, parent, code and hierarchy level as the report engine walks them; all rows",
    "source_sql": "SELECT id, report_id, parent_id, sequence, code, hierarchy_level FROM account_report_line ORDER BY sequence, id",
    "target_pipeline": [
      {
        "$sort": {
          "sequence": 1,
          "_id": 1
        }
      },
      {
        "$project": {
          "_id": 0,
          "id": "$_id",
          "report_id": {
            "$ifNull": [
              "$reportId",
              null
            ]
          },
          "parent_id": {
            "$ifNull": [
              "$parentId",
              null
            ]
          },
          "sequence": {
            "$ifNull": [
              "$sequence",
              null
            ]
          },
          "code": {
            "$ifNull": [
              "$code",
              null
            ]
          },
          "hierarchy_level": {
            "$ifNull": [
              "$hierarchyLevel",
              null
            ]
          }
        }
      }
    ],
    "rules": [
      "null_missing_equiv"
    ]
  },
  {
    "name": "lines_per_report",
    "collection": "accountReportLine",
    "note": "AccountReport line_ids count and root lines (parent_id unset) per report, as _compute_hierarchy_level / _check_parent_line read them (addons/account/models/account_report.py:472, :533)",
    "source_sql": "SELECT report_id, count(*) AS lines, count(*) FILTER (WHERE parent_id IS NULL) AS root_lines FROM account_report_line GROUP BY report_id ORDER BY report_id",
    "target_pipeline": [
      {
        "$group": {
          "_id": "$reportId",
          "lines": {
            "$sum": 1
          },
          "root_lines": {
            "$sum": {
              "$cond": [
                {
                  "$eq": [
                    {
                      "$ifNull": [
                        "$parentId",
                        null
                      ]
                    },
                    null
                  ]
                },
                1,
                0
              ]
            }
          }
        }
      },
      {
        "$project": {
          "_id": 0,
          "report_id": "$_id",
          "lines": 1,
          "root_lines": 1
        }
      },
      {
        "$sort": {
          "report_id": 1
        }
      }
    ],
    "rules": []
  }
]
