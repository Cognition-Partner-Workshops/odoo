[
 {
  "name": "verify_uomUom_audit_columns_by_id",
  "collection": "uomUom",
  "note": "uom_uom: create/write uid and date per row (mail/chatter and the record's metadata read), keyed by id",
  "source_sql": "SELECT id, create_uid, write_uid, create_date, write_date FROM uom_uom ORDER BY id",
  "target_pipeline": [
   {
    "$project": {
     "_id": 0,
     "id": "$_id",
     "create_uid": {
      "$ifNull": [
       "$createUid",
       null
      ]
     },
     "write_uid": {
      "$ifNull": [
       "$writeUid",
       null
      ]
     },
     "create_date": {
      "$ifNull": [
       "$createDate",
       null
      ]
     },
     "write_date": {
      "$ifNull": [
       "$writeDate",
       null
      ]
     }
    }
   },
   {
    "$sort": {
     "id": 1
    }
   }
  ],
  "rules": [
   "datetime_utc_truncate_ms",
   "null_missing_equiv"
  ]
 },
 {
  "name": "verify_uomUom_scalar_listing",
  "collection": "uomUom",
  "note": "uom_uom: every int/string/bool column of every row as a list view reads it, keyed by id",
  "source_sql": "SELECT id, sequence, relative_uom_id, parent_path, active, package_type_id, unece_code FROM uom_uom ORDER BY id",
  "target_pipeline": [
   {
    "$project": {
     "_id": 0,
     "id": "$_id",
     "sequence": {
      "$ifNull": [
       "$sequence",
       null
      ]
     },
     "relative_uom_id": {
      "$ifNull": [
       "$relativeUomId",
       null
      ]
     },
     "parent_path": {
      "$ifNull": [
       "$parentPath",
       null
      ]
     },
     "active": {
      "$ifNull": [
       "$active",
       null
      ]
     },
     "package_type_id": {
      "$ifNull": [
       "$packageTypeId",
       null
      ]
     },
     "unece_code": {
      "$ifNull": [
       "$uneceCode",
       null
      ]
     }
    }
   },
   {
    "$sort": {
     "id": 1
    }
   }
  ],
  "rules": [
   "null_missing_equiv"
  ]
 }
]
