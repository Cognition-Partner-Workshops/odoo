 {
  "name": "verify_accountReport_embed_fanout_by_parent",
  "collection": "accountReport",
  "note": "account_report: per-parent count of each embedded array (account_report_column, account_report_section_rel) against the child-row count, keyed by id",
  "source_sql": "SELECT r.id, COALESCE(e0.n, 0) AS n_column, COALESCE(e1.n, 0) AS n_sectionrel FROM account_report r LEFT JOIN (SELECT report_id AS pid, COUNT(*) AS n FROM account_report_column GROUP BY report_id) e0 ON e0.pid = r.id LEFT JOIN (SELECT main_report_id AS pid, COUNT(*) AS n FROM account_report_section_rel GROUP BY main_report_id) e1 ON e1.pid = r.id ORDER BY r.id",
  "target_pipeline": [
   {
    "$project": {
     "_id": 0,
     "id": "$_id",
     "n_column": {
      "$size": {
       "$ifNull": [
        "$column",
        []
       ]
      }
     },
     "n_sectionrel": {
      "$size": {
       "$ifNull": [
        "$sectionRel",
        []
       ]
      }
     }
    }
   },
   {
    "$sort": {
     "id": 1
    }
   }
  ],
  "rules": []
 }
]
