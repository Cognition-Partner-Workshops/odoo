 {
  "name": "verify_accountReport_audit_columns_by_id",
  "collection": "accountReport",
  "note": "account_report: create/write uid and date per row (mail/chatter and the record's metadata read), keyed by id",
  "source_sql": "SELECT id, create_uid, write_uid, create_date, write_date FROM account_report ORDER BY id",
  "target_pipeline": [
   {
    "$project": {
     "_id": 0,
     "id": "$_id",
     "create_uid": {
      "$ifNull": [
       "$createUid",
       null
      ]
     },
     "write_uid": {
      "$ifNull": [
       "$writeUid",
       null
      ]
     },
     "create_date": {
      "$ifNull": [
       "$createDate",
       null
      ]
     },
     "write_date": {
      "$ifNull": [
       "$writeDate",
       null
      ]
     }
    }
   },
   {
    "$sort": {
     "id": 1
    }
   }
  ],
  "rules": [
   "datetime_utc_truncate_ms",
   "null_missing_equiv"
  ]
 },
